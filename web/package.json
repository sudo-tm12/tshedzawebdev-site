{
  "name": "tshedzawebdev-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "predev": "node scripts/sync-pricebook.mjs",
    "prebuild": "node scripts/sync-pricebook.mjs",
    "pretest": "node scripts/sync-pricebook.mjs",
    "parity": "node scripts/sync-pricebook.mjs && node --experimental-strip-types scripts/parity-fixtures.mjs && node scripts/run-php.mjs ../api/tests/parity.php",
    "postbuild": "node scripts/redirects.mjs && node scripts/check-links.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
